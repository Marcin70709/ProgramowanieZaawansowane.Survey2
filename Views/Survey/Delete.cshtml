@model ProgramowanieZaawansowane.Survey.Models.Survey

<h2>Czy na pewno chcesz usunąć ankietę?</h2>

<div class="card mt-3">
    <div class="card-body">
        <h4>@Model.Title</h4>
        <p>@Model.Description</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        Tak, usuń
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Anuluj
    </a>
</form>